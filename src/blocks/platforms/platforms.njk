<section class="platforms container">
  <h2>{{ platforms.title }}</h2>
  <ul class="platforms__list">
    {% for platform in platforms.items %}
    <li>
      <img src="./images/{{ platform.image }}" width="80" height="80" alt="" loading="lazy" decoding="async">
      <p>{{ platform.title }}</p>
    </li>
    {% endfor %}
  </ul>
</section>
