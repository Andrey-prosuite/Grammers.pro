<section class="featured-project" aria-labelledby="featured-project-title">
  <div class="featured-project__content">
    <h2 id="featured-project-title">{{ featured.title }}</h2>
    <ul>
      {% for item in featured.items %}<li>{{ item }}</li>{% endfor %}
    </ul>
    <a class="featured-project__link" href="https://ag-technologies.ru/">{{ featured.link }}</a>
  </div>
  <figure class="featured-project__preview">
    <img class="featured-project__desktop" src="./images/projects/ag-desktop.jpg" width="758" height="3913" alt="Интерфейс интернет-магазина ag-technologies.ru" loading="lazy" decoding="async">
    <img class="featured-project__phone" src="./images/projects/ag-phone.svg" width="260" height="531" alt="" loading="lazy" decoding="async">
  </figure>
</section>
