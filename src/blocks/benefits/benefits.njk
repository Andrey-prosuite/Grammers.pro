{% from "components/text-lines.njk" import textLines %}
{% from "components/section-heading/section-heading.njk" import sectionHeading %}
<section class="benefits container">
  {{ sectionHeading(benefits.label, benefits.title) }}
  <div class="benefits__content">
    {% for card in benefits.cards %}
    <article>
      <h3>{{ textLines(card.title) }}</h3>
      <p>{{ card.text }}</p>
      {% if loop.first %}<a class="button" href="https://grammers.pro/o_nas">{{ benefits.cta }}</a>{% endif %}
    </article>
    {% endfor %}
  </div>
</section>
