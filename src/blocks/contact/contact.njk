{% from "components/text-lines.njk" import textLines %}
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__intro">
    <h2 id="contact-title">{{ textLines(contact.title) }}</h2>
    <p class="contact__question">{{ contact.subtitle }}</p>
    <div class="contact__messengers">
      <a class="button" href="https://t.me/grammers_pro">{{ contact.telegram }}</a>
      <button class="button" type="button" disabled>{{ contact.max }}</button>
    </div>
    <figure class="contact__manager">
      <img src="./images/brand/alexander.webp" width="73" height="73" alt="" loading="lazy" decoding="async">
      <figcaption>{{ contact.name }}<small>{{ contact.role }}</small></figcaption>
    </figure>
  </div>
  <form class="contact__form" aria-label="Обсудить проект">
    <label for="project-title">Расскажите о своем проекте</label>
    <input id="project-title" name="title" type="text" placeholder="Корпоративный сайт">
    <fieldset class="contact__budget">
      <legend>Бюджет</legend>
      <label><input type="radio" name="budget" value="under-500"> &lt; 500 тыс.</label>
      <label><input type="radio" name="budget" value="500-1000"> от 500 тыс. до 1 млн.</label>
      <label><input type="radio" name="budget" value="1000-3000"> от 1 млн. до 3 млн.</label>
      <label><input type="radio" name="budget" value="over-3000"> от 3 млн.</label>
    </fieldset>
    <label for="project-description">Описание проекта</label>
    <textarea id="project-description" name="description" rows="3" placeholder=" тематика, цели, основные конкуренты"></textarea>
    <div class="contact__details">
      <input name="name" type="text" autocomplete="name" placeholder="Ваше имя" aria-label="Ваше имя">
      <input name="email" type="email" autocomplete="email" placeholder="Ваш email" aria-label="Ваш email">
      <input name="phone" type="tel" autocomplete="tel" placeholder="+7 (000) 000-00-00" aria-label="Телефон">
    </div>
    <input name="website" type="url" autocomplete="url" placeholder="Сайт" aria-label="Сайт">
    <label class="contact__consent"><input type="checkbox" name="consent" required> Даю согласие на обработку персональных данных</label>
    <button class="button" type="submit" disabled>Обсудить проект</button>
  </form>
</section>
