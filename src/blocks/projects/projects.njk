<section class="projects container" aria-labelledby="projects-title">
  <h2 id="projects-title">{{ projects.title }}</h2>
  <div class="projects__grid">
    {% for project in projects.items %}
    <article class="projects__item">
      {% if project.href %}<a href="{{ project.href }}">{% endif %}
        <img src="./images/{{ project.image }}" width="860" height="720" alt="" loading="lazy" decoding="async">
        <h3>{{ project.title }}</h3>
      {% if project.href %}</a>{% endif %}
    </article>
    {% endfor %}
  </div>
  <a class="button projects__more" href="https://grammers.pro/cases">{{ projects.cta }}</a>
</section>
