{% from "components/section-heading/section-heading.njk" import sectionHeading %}
<section class="credentials container">
  {{ sectionHeading(credentials.label, credentials.title) }}
  <div class="credentials__grid">
    <ul class="credentials__primary">
      {% for item in credentials.primary %}<li>{{ item }}</li>{% endfor %}
      <li class="credentials__ranks">
        {% for item in credentials.ranks %}<p>{{ item }}</p>{% endfor %}
      </li>
    </ul>
    <ul class="credentials__secondary">
      {% for item in credentials.secondary %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
  <div class="credentials__accreditation">
    <p>{{ credentials.accreditation }}</p>
    <img src="./images/brand/ministry.png" width="180" height="40" alt="Минцифры России" loading="lazy" decoding="async">
    <img src="./images/brand/arda.svg" width="140" height="40" alt="ARDA" loading="lazy" decoding="async">
  </div>
</section>
